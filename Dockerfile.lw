# Lightweight Alpine image for 3x-ui-lw. It intentionally packages only the
# panel, SQLite, and Xray. The regular Dockerfile remains the full distribution.
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
COPY internal/web/translation /src/internal/web/translation
ENV VITE_XUI_PROFILE=lw
# Keep only the Chinese catalog in the Vite input. The source still imports the
# stable fallback module, so retain en-US as an alias during this build.
RUN cp /src/internal/web/translation/zh-CN.json /src/internal/web/translation/en-US.json \
    && find /src/internal/web/translation -type f ! -name 'zh-CN.json' ! -name 'en-US.json' -delete
RUN npm run build
RUN node scripts/prune-lw-dist.mjs

FROM golang:1.27-alpine AS builder
WORKDIR /app
ARG TARGETARCH
ARG XRAY_VERSION=v26.9.9
RUN apk add --no-cache build-base curl unzip
COPY . .
COPY --from=frontend /src/internal/web/dist ./internal/web/dist
# The lightweight binary has no language picker or bot sidecars. Keep only the
# Chinese catalog so go-i18n does not parse and retain every locale at startup.
RUN find internal/web/translation -type f ! -name 'zh-CN.json' -delete
ENV CGO_ENABLED=1
ENV CGO_CFLAGS=-D_LARGEFILE64_SOURCE
RUN go build -trimpath -ldflags "-w -s" -o build/x-ui main.go
RUN XRAY_VERSION="$XRAY_VERSION" ./DockerInit.lw.sh "$TARGETARCH"

FROM scratch AS lw-package
COPY --from=builder /app/build/ /

FROM alpine:3.22
ENV TZ=UTC \
    XUI_IN_DOCKER=true \
    XUI_MAIN_FOLDER=/app \
    XUI_PROFILE=lw \
    XUI_ENABLE_FAIL2BAN=false \
    XUI_DB_TYPE=sqlite \
    XUI_MEMORY_LIMIT=64 \
    XUI_GOGC=25 \
    XUI_MEMORY_RELEASE_INTERVAL=3 \
    XUI_DB_CACHE_MB=4 \
    XUI_DB_MMAP_MB=0 \
    XUI_DB_TEMP_STORE=FILE \
    XUI_DB_MAX_OPEN_CONNS=2 \
    XUI_DB_MAX_IDLE_CONNS=1 \
    GODEBUG=madvdontneed=1
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /app/build/ /app/
COPY --from=builder /app/DockerEntrypoint.lw.sh /app/DockerEntrypoint.sh
COPY --from=builder /app/internal/web/translation /app/internal/web/translation
RUN chmod 0755 /app/x-ui /app/DockerEntrypoint.sh
EXPOSE 2053
VOLUME ["/etc/x-ui", "/var/log/x-ui"]
ENTRYPOINT ["/app/DockerEntrypoint.sh"]
